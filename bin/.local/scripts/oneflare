#!/usr/bin/env bash
# usage: ./oneflare [--local|--quick] file1.zip [file2.zip ...]
#   --local   serve only on localhost (no tunnel)
#   --quick   use Cloudflare free quick tunnel (*.trycloudflare.com, no config or domain needed)

set -e

## Cloudflare Tunnel Configuration
# Required when not using --local: set ONEFLARE_TUNNEL_DOMAIN (e.g. example.com)
TUNNEL_NAME="${ONEFLARE_TUNNEL_NAME:-oneflare}"
TUNNEL_CONFIG_DIR="${ONEFLARE_CONFIG_DIR:-$HOME/.cloudflared}"
TUNNEL_CONFIG_FILE="$TUNNEL_CONFIG_DIR/$TUNNEL_NAME.yml"

# Colors and styles
BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color
DIM='\033[2m'

# Icons
CHECK='✓'
CROSS='✗'
ARROW='→'
FOLDER='📁'
FILE_ICON='📄'
SPINNER_CHARS='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'

PORT=8080

LOCAL_ONLY=0
QUICK_TUNNEL=0
if [[ $# -gt 0 && "$1" == "--local" ]]; then
    LOCAL_ONLY=1
    shift
fi
if [[ $# -gt 0 && "$1" == "--quick" ]]; then
    QUICK_TUNNEL=1
    shift
fi

# Check if files are provided
[ $# -eq 0 ] && {
    echo -e "${RED}${CROSS}${NC} No files provided" >&2
    echo -e "${DIM}Usage: $0 file1 [file2 ...]${NC}" >&2
    exit 1
}

# Validate all files exist and collect them
FILES=()
MISSING_FILES=()
for file in "$@"; do
    if [ -f "$file" ]; then
        FILES+=("$file")
    else
        MISSING_FILES+=("$file")
    fi
done

[ ${#MISSING_FILES[@]} -gt 0 ] && {
    echo -e "${RED}${CROSS}${NC} File(s) not found:" >&2
    for file in "${MISSING_FILES[@]}"; do
        echo -e "   ${BOLD}$file${NC}" >&2
    done
    exit 1
}

[ ${#FILES[@]} -eq 0 ] && {
    echo -e "${RED}${CROSS}${NC} No valid files provided" >&2
    exit 1
}

TOKEN="$(openssl rand -hex 16)"

# Signal flag for graceful shutdown
SIGNAL_RECEIVED=0
SIGNAL_FLAG=""

# Function to clean up on exit
cleanup() {
    SIGNAL_RECEIVED=1
    # Signal spinner to stop if it exists
    [ -n "$SIGNAL_FLAG" ] && touch "$SIGNAL_FLAG" 2>/dev/null || true
    echo -e "\n${YELLOW}${ARROW}${NC} Stopping server and tunnel..."
    kill "$PY_PID" "$CF_PID" "$SPINNER_PID" 2>/dev/null || true
    [ -n "$SIGNAL_FLAG" ] && rm -f "$SIGNAL_FLAG" 2>/dev/null || true
    echo -e "${GREEN}${CHECK}${NC} Cleanup complete"
    exit
}
trap cleanup SIGINT SIGTERM

python3 - "$TOKEN" "${FILES[@]}" <<'EOF' &
from http.server import HTTPServer, SimpleHTTPRequestHandler
import sys, os
import html as _html
from urllib.parse import urlparse, parse_qs, unquote, quote
import mimetypes

TOKEN = sys.argv[1]
FILES = sys.argv[2:]

# Map full path -> full path (use full path as key so same basenames don't overwrite)
FILE_MAP = {os.path.abspath(f): f for f in FILES}

def path_to_url_segment(filepath):
    """URL-safe segment for a file path (unique per full path)."""
    return quote(os.path.abspath(filepath), safe='')

def format_size(size):
    for unit in ['B', 'KB', 'MB', 'GB']:
        if size < 1024.0:
            return f"{size:.1f} {unit}"
        size /= 1024.0
    return f"{size:.1f} TB"

def is_text_file(filepath):
    """Check if file is a text file that can be viewed"""
    text_extensions = {'.txt', '.md', '.json', '.xml', '.html', '.css', '.js',
                       '.py', '.sh', '.bash', '.zsh', '.yaml', '.yml', '.toml',
                       '.ini', '.conf', '.log', '.csv', '.tsv', '.ts', '.jsx',
                       '.tsx', '.vue', '.svelte', '.go', '.rs', '.java', '.c',
                       '.cpp', '.h', '.hpp', '.php', '.rb', '.swift', '.kt',
                       '.dart', '.lua', '.pl', '.r', '.sql', '.graphql', '.gql'}
    ext = os.path.splitext(filepath)[1].lower()
    if ext in text_extensions:
        return True
    # Check MIME type
    mime_type, _ = mimetypes.guess_type(filepath)
    if mime_type and mime_type.startswith('text/'):
        return True
    # Check if file is small enough and likely text
    try:
        if os.path.getsize(filepath) < 5 * 1024 * 1024:  # 5MB limit
            with open(filepath, 'rb') as f:
                chunk = f.read(512)
                # Check if mostly printable ASCII
                printable = sum(1 for b in chunk if 32 <= b <= 126 or b in [9, 10, 13])
                return printable > len(chunk) * 0.8
    except:
        pass
    return False

def is_image_file(filepath):
    """Check if file is an image"""
    image_extensions = {'.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp',
                        '.svg', '.ico', '.tiff', '.tif'}
    ext = os.path.splitext(filepath)[1].lower()
    if ext in image_extensions:
        return True
    mime_type, _ = mimetypes.guess_type(filepath)
    return mime_type and mime_type.startswith('image/')

