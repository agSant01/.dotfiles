                            <a href="{download_url}" class="btn btn-download" onclick="event.stopPropagation();" download>Download</a>
                            <button class="btn btn-copy" onclick="event.stopPropagation(); copyUrl('{file_url}', this)">Copy Link</button>
                        </div>
                    </div>
                </div>
"""
